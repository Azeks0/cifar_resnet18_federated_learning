{
  "seed": 42,
  "data_dir": "data",
  "stl10_dir": "data/stl10",
  "output_dir": "outputs/feddf",
  "download": true,
  "dataset": {
    "val_size": 5000,
    "server_size": 10000,
    "n_clients": 3,
    "distillation_size": 10000,
    "num_classes": 10,
    "dirichlet_alpha": 0.5
  },
  "model": {
    "name": "resnet18_feddf",
    "num_classes": 10
  },
  "federated": {
    "rounds": 10
  },
  "server_pretrain": {
    "epochs": 15,
    "warmup_epochs": 3,
    "batch_size": 256,
    "num_workers": 2,
    "optimizer": "sgd",
    "learning_rate": 0.1,
    "momentum": 0.9,
    "weight_decay": 0.0005,
    "scheduler": "cosine"
  },
  "server_distill": {
    "epochs": 3,
    "batch_size": 256,
    "num_workers": 0,
    "optimizer": "sgd",
    "learning_rate": 0.01,
    "momentum": 0.9,
    "weight_decay": 0.0005,
    "scheduler": "none",
    "temperature": 4.0,
    "distill_alpha": 0.5
  },
  "client": {
    "epochs": 3,
    "batch_size": 256,
    "num_workers": 2,
    "optimizer": "sgd",
    "learning_rate": 0.05,
    "momentum": 0.9,
    "weight_decay": 0.0005,
    "scheduler": "none"
  }
}
